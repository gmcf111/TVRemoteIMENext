<?xml version="1.0" encoding="utf-8"?>
<!-- 局域网 cleartext（控制端 http://ip:9978）；GitHub Releases https 不受影响 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
